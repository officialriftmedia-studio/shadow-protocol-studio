{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductionPackage",
  "type": "object",
  "required": ["episode_id", "title", "logline", "estimated_duration_seconds", "scenes", "tone"],
  "properties": {
    "episode_id": { "type": "string", "pattern": "^case_\\d{3}$" },
    "title": { "type": ["string", "null"] },
    "logline": { "type": ["string", "null"] },
    "estimated_duration_seconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
    "scenes": { "type": "integer", "minimum": 1 },
    "tone": { "type": "string" },
    "protagonist": { "type": "object" },
    "antagonist": { "type": "object" },
    "mystery_stack": { "type": "object" },
    "required_bible_updates": { "type": "array", "items": { "type": "string" } }
  }
}
