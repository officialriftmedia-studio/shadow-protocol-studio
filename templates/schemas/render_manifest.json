{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RenderManifest",
  "type": "object",
  "required": ["render_time", "input_assets", "errors", "scene_count"],
  "properties": {
    "render_time": { "type": "string" },
    "duration_seconds": { "type": "number" },
    "input_assets": {
      "type": "object",
      "properties": {
        "images": { "type": "array", "items": { "type": "string" } },
        "voiceover": { "type": "array", "items": { "type": "string" } }
      }
    },
    "output_size_bytes": { "type": "integer" },
    "output_path": { "type": "string" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "scene_count": { "type": "integer" },
    "succeeded_scenes": { "type": "integer" },
    "failed_scenes": { "type": "integer" }
  }
}
