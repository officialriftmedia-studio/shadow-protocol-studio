{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BibleUnresolvedMysteries",
  "type": "object",
  "required": ["meta", "mysteries"],
  "properties": {
    "meta": { "$ref": "characters.json#/properties/meta" },
    "mysteries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "status"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "partially_resolved", "resolved", "abandoned"] },
          "introduced_in": { "type": "string" },
          "resolved_in": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
