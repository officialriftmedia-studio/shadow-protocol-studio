{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BibleThemes",
  "type": "object",
  "required": ["meta", "themes"],
  "properties": {
    "meta": { "$ref": "characters.json#/properties/meta" },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
