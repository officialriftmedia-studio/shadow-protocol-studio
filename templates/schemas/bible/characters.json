{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BibleCharacters",
  "type": "object",
  "required": ["meta", "characters"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["description", "version", "last_updated"],
      "properties": {
        "description": { "type": "string" },
        "version": { "type": "string" },
        "last_updated": { "type": ["string", "null"] }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "status", "appears_in"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "status": { "type": "string", "enum": ["alive", "dead", "missing", "unknown"] },
          "appears_in": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "motivation": { "type": "string" },
          "affiliation": { "type": "string" }
        }
      }
    }
  }
}
