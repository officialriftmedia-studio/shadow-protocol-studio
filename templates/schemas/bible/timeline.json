{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BibleTimeline",
  "type": "object",
  "required": ["meta", "events"],
  "properties": {
    "meta": { "$ref": "characters.json#/properties/meta" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "description", "episode"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string" },
          "description": { "type": "string" },
          "episode": { "type": "string" },
          "related_characters": { "type": "array", "items": { "type": "string" } },
          "related_locations": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
