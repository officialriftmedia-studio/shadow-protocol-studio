{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BibleLocations",
  "type": "object",
  "required": ["meta", "locations"],
  "properties": {
    "meta": { "$ref": "characters.json#/properties/meta" },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "appears_in"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["urban", "rural", "wilderness", "facility", "digital", "other"] },
          "appears_in": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "coordinates": { "type": "object" }
        }
      }
    }
  }
}
