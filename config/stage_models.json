{
  "$schema": "stage_models.schema.json",
  "description": "Per-stage provider/model overrides. Creative stages use gemini-2.5-flash; extraction/formatting/utility stages use gemini-3.1-flash-lite. The pipeline checks this file first; falls back to LLM_PROVIDER/LLM_MODEL env vars.",
  "defaults": {
    "provider": "gemini",
    "model": "gemini-2.5-flash"
  },
  "stages": {
    "production_package": {
      "provider": "gemini",
      "model": "gemini-2.5-flash"
    },
    "outline": {
      "provider": "gemini",
      "model": "gemini-2.5-flash"
    },
    "script": {
      "provider": "gemini",
      "model": "gemini-2.5-flash"
    },
    "script_review": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-lite"
    },
    "scene_breakdown": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-lite"
    },
    "asset_package": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-lite"
    },
    "voiceover": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-lite"
    },
    "metadata": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-lite"
    },
    "thumbnail": {
      "provider": "gemini",
      "model": "gemini-3.1-flash-lite"
    },
    "image_generator": {
      "provider": "none"
    },
    "voice_generator": {
      "provider": "none"
    }
  }
}
