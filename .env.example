# LLM Provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Image Generation (Phase 3)
IMAGE_PROVIDER=google_imagen
IMAGE_MODEL=imagen-3.0

# Video Generation (future)
VIDEO_PROVIDER=runway
VIDEO_MODEL=gen-3

# Voiceover (Phase 3)
VOICE_PROVIDER=google_tts
VOICE_MODEL=wavesynth

# Storage
PROJECTS_DIR=./projects
MEMORY_DIR=./memory

# Logging
LOG_LEVEL=INFO
